# Port server (default 4000)
PORT=4000

# Token autentikasi dari ShopeePay Partner Web
# Ambil dari cookie/session setelah login di partner.shopee.co.id
SHOPEE_TOKEN=your_shopee_partner_token_here

# API key untuk proteksi endpoint (buat sendiri, random string)
API_KEY=your_secret_api_key_here

# Telegram bot untuk notifikasi token expired
# Buat bot via @BotFather, ambil token-nya
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFghijklMNOPqrstUVWXyz123456789
TELEGRAM_CHAT_ID=123456789

# QRIS statis dari merchant ShopeePay
# Copy dari dashboard partner atau scan QR fisik dan decode isinya
QRIS_STATIC=00020101021126610016ID.CO.SHOPEE.WWW0118936009180000000000020800000000030355555144001...
